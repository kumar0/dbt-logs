# dbt Environment Variables
# Copy this file to .env and fill in the values after deploying the CDK stack

# Get these values by running: source setup_env.sh
# Or manually from CDK stack outputs: cdk deploy --profile mondayskills.development

# IAM Role ARN for Glue jobs (from CDK output: GlueJobRoleArn)
DBT_GLUE_ROLE_ARN=arn:aws:iam::<account-id>:role/etl-glue-job-role-<region>

# S3 location for dbt outputs (from CDK output: DataLakeLocation)
DBT_GLUE_LOCATION=s3://etl-datalake-<account-id>-<region>/dbt/

# AWS Region
AWS_REGION=us-east-1

# AWS Profile
AWS_PROFILE=mondayskills.development
